# Mushroom Foray Spore Print Matcher — optional overrides.
# Copy to `.env` if you want to change a default. Every value is optional:
# the app boots with no `.env` file at all.

# HTTP port (Gradio's default is 7860).
PORT=7860

# Embedded SQLite file, relative to the project root.
DATABASE_URL=sqlite:///./foray.db

# Where uploaded spore-print photos are stored (outside the served tree).
UPLOAD_DIR=./uploads

# Session-signing secret. Leave empty to use the in-code development fallback;
# `bash install.sh` writes a random 64-character value here on first run.
SESSION_SECRET=
